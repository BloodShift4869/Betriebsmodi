<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Betriebsmodi.ViewModels"
             xmlns:views="using:Betriebsmodi.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Betriebsmodi.Views.FreeModeView"
             x:DataType="vm:FreeModeViewModel">
    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*, Auto, Auto" RowSpacing="10">
        <!-- Title bar -->
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="30, 30, 0, 0" VerticalAlignment="Center" FontSize="36"
                   Text="{Binding Mode}"
                   FontWeight="Bold" />
        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0, 30, 0, 0" Text="Anzahl Kerne:" VerticalAlignment="Center" />
        <Border Grid.Row="0" Grid.Column="2" Margin="10, 30, 30, 0" Background="Aqua" Width="40" Height="40"
                VerticalAlignment="Center">
            <TextBlock FontSize="24" Text="{Binding Cores}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>

        <!-- Speed selection -->
        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Label>1x</Label>
            <Label>2x</Label>
        </StackPanel>

        <!-- Main area -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" RowDefinitions="40,40,40,40,40,40,40,*"
              ColumnDefinitions="Auto,*" Margin="30 0 0 10" RowSpacing="10" ColumnSpacing="10">
            <!-- Legend view -->
            <views:ECBLegendView Grid.Column="0" Grid.Row="0" Grid.RowSpan="8" IsVisible="{Binding IsECB}" />
            <views:CBCLegendView Grid.Column="0" Grid.Row="0" Grid.RowSpan="8" IsVisible="{Binding IsCBC}" />
            <views:CTRLegendView Grid.Column="0" Grid.Row="0" Grid.RowSpan="8" IsVisible="{Binding IsCTR}" />

            <!-- ScrollViewer containing encryption blocks -->
            <ScrollViewer Grid.Row="0" Grid.Column="1" Grid.RowSpan="8" HorizontalScrollBarVisibility="Visible">
                <ItemsControl ItemsSource="{Binding ModeViewModel}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Timer -->
        <StackPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Margin="10, 0">
                <TextBlock Text="{Binding MsWhole, StringFormat='{}{0},'}" FontSize="24"></TextBlock>
                <TextBlock Text="{Binding MsDecimal}" Margin="0, 10, 0, 0"></TextBlock>
            </StackPanel>
            <TextBlock Text="ms" Margin="10, 10"></TextBlock>
        </StackPanel>
    </Grid>
</UserControl>