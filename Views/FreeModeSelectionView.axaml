<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Betriebsmodi.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Betriebsmodi.Views.FreeModeSelectionView"
             x:DataType="vm:FreeModeSelectionViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto, *" RowSpacing="10" Margin="30 30">
        <!-- Title -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontSize="36" Margin="0 0 0 20"
                   Text="Einrichtung des freien Modus"
                   FontWeight="Bold" />

        <!-- Mode selector -->
        <TextBlock VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Text="Betriebsmodus:" />
        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" MaxDropDownHeight="100" VerticalAlignment="Center"
                  Margin="10 0">
            <ComboBoxItem>ECB</ComboBoxItem>
            <ComboBoxItem>CBC</ComboBoxItem>
            <ComboBoxItem>CTR</ComboBoxItem>
        </ComboBox>

        <!-- Plaintext input -->
        <TextBlock VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Text="Klartext:" />
        <TextBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Width="300" Margin="10 0" />

        <!-- Plaintext input -->
        <TextBlock VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Text="Schlüssel:" />
        <TextBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Width="300" Margin="10 0" />

        <Button Grid.Row="4" Grid.Column="1" Background="SteelBlue"
                Width="150" HorizontalContentAlignment="Center" VerticalAlignment="Top" Content="Verschlüsseln"
                Margin="10 0" />
    </Grid>
</UserControl>